# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit the real .env file.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "service_role" secret key (not the public "anon" key) - required so the
# collector can write to outage_snapshots and region_readings.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Cloudflare Web Analytics site token. Leave blank for local builds
# so your own previews are not counted as visits.
CLOUDFLARE_ANALYTICS_TOKEN=

# Optional: LinkedIn Insight Tag partner ID (digits only). Leave blank locally.
LINKEDIN_PARTNER_ID=
